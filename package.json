{
	"name": "loopback",
	"private": true,
	"description": "A human-in-the-loop inbox for coding agents: an MCP server on Cloudflare Workers.",
	"keywords": [
		"cloudflare-workers",
		"coding-agents",
		"durable-objects",
		"human-in-the-loop",
		"mcp",
		"model-context-protocol"
	],
	"homepage": "https://github.com/LoopBackTools/loopback#readme",
	"bugs": {
		"url": "https://github.com/LoopBackTools/loopback/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LoopBackTools/loopback.git"
	},
	"type": "module",
	"scripts": {
		"generate": "pnpm -r generate",
		"typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts",
		"lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives --ignore-pattern \"**/*.gen.ts\"",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run scripts && pnpm -r test",
		"build": "pnpm -r build",
		"dev": "pnpm --filter ./apps/loopback dev",
		"deploy": "node scripts/deploy.ts"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"es-module-lexer": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": "^22.23.0 || ^24.22.0 || >=26.12.0",
		"pnpm": ">=11"
	},
	"packageManager": "pnpm@11.18.0"
}
