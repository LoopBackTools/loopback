{
	"name": "@loopbacktools/protocol",
	"version": "0.7.0",
	"description": "The Loopback API contract: the TypeSpec definition, its generated types and the OpenAPI document.",
	"homepage": "https://github.com/LoopBackTools/loopback/tree/main/packages/protocol#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LoopBackTools/loopback.git",
		"directory": "packages/protocol"
	},
	"files": [
		"dist",
		"openapi",
		"spec"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./document": "./src/generated/document.gen.ts",
		"./schema": "./src/schema.ts",
		"./openapi.json": "./openapi/openapi.1.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/src/index.js"
			},
			"./document": {
				"types": "./dist/src/generated/document.gen.d.ts",
				"default": "./dist/src/generated/document.gen.js"
			},
			"./schema": {
				"types": "./dist/src/schema.d.ts",
				"default": "./dist/src/schema.js"
			},
			"./openapi.json": "./openapi/openapi.1.json"
		},
		"access": "public"
	},
	"scripts": {
		"generate": "tsp compile spec/main.tsp --config tspconfig.yaml && node scripts/schemas.ts",
		"freeze": "node scripts/freeze.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@effect/openapi-generator": "catalog:",
		"@hono/zod-validator": "catalog:",
		"@types/node": "catalog:",
		"@typespec/compiler": "catalog:",
		"@typespec/http": "catalog:",
		"@typespec/openapi": "catalog:",
		"@typespec/openapi3": "catalog:",
		"@typespec/streams": "catalog:",
		"@typespec/versioning": "catalog:",
		"hono": "catalog:",
		"secure-json-parse": "catalog:",
		"typescript": "catalog:",
		"typespec-hono": "catalog:",
		"typespec-openapi-document": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.0.6"
	}
}
