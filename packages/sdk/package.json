{
	"name": "@loopbacktools/sdk",
	"version": "0.7.1",
	"description": "A client for Loopback: read and answer what agents ask, and follow the inbox live, from any frontend.",
	"homepage": "https://github.com/LoopBackTools/loopback/tree/main/packages/sdk#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LoopBackTools/loopback.git",
		"directory": "packages/sdk"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/src/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"@loopbacktools/protocol": "workspace:*"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"effect": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.0.6"
	}
}
