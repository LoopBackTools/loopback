{
	"name": "loopback",
	"version": "0.7.1",
	"private": true,
	"description": "The deployable Loopback edge: the contract's routes and MCP tools in front of the core, the token or JWT gate, and the web inbox.",
	"homepage": "https://github.com/LoopBackTools/loopback/tree/main/apps/loopback#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LoopBackTools/loopback.git",
		"directory": "apps/loopback"
	},
	"type": "module",
	"scripts": {
		"generate": "tsp compile spec/main.tsp --config tspconfig.yaml",
		"dev": "pnpm generate && vite dev",
		"build": "pnpm generate && vite build",
		"preview": "pnpm generate && vite build && vite preview",
		"deploy": "cf deploy",
		"types": "cf workers types && cd test/edge && cf workers types",
		"typecheck": "pnpm generate && pnpm types && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p test/edge",
		"test": "pnpm generate && vitest run"
	},
	"dependencies": {
		"@cloudflare/kumo": "catalog:",
		"@effect/atom-react": "catalog:",
		"@hono/zod-validator": "catalog:",
		"@loopbacktools/app": "workspace:*",
		"@loopbacktools/core": "workspace:*",
		"@loopbacktools/inbox": "workspace:*",
		"@loopbacktools/protocol": "workspace:*",
		"@loopbacktools/sdk": "workspace:*",
		"@modelcontextprotocol/server": "catalog:",
		"@phosphor-icons/react": "catalog:",
		"effect": "catalog:",
		"hono": "catalog:",
		"jose": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router": "catalog:",
		"secure-json-parse": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/config": "catalog:",
		"@cloudflare/vite-plugin": "catalog:",
		"@cloudflare/vitest-plugin": "catalog:",
		"@cloudflare/workers-types": "catalog:",
		"@effect/vitest": "catalog:",
		"@modelcontextprotocol/client": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@typespec/compiler": "catalog:",
		"@typespec/http": "catalog:",
		"@typespec/openapi": "catalog:",
		"@typespec/openapi3": "catalog:",
		"@typespec/streams": "catalog:",
		"@typespec/versioning": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"cf": "catalog:",
		"jsdom": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"typespec-hono": "catalog:",
		"typespec-http-mcp": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
